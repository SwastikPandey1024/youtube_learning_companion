# YouTube Learning Companion — Environment Configuration Template
# Copy this file to .env and configure as needed.

# ── YouTube Data API v3 (Optional) ───────────────────────────
# If left empty, companion falls back to public web discovery mode.
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_REQUEST_TIMEOUT_SECONDS=15.0
YOUTUBE_MAX_RESULTS_PER_PAGE=50

# ── Output Directory ─────────────────────────────────────────
NOTES_EXPORT_DIR=data/notes

# ── LLM Synthesis Configuration ──────────────────────────────
# Supported providers: 'openai', 'ollama', 'mock'
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2

# ── Local Ollama Example (when LLM_PROVIDER=ollama) ───────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_API_BASE_URL=http://localhost:11434/v1
